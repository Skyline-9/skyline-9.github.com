---
import { siteConfig } from "../data/site";
const currentYear = new Date().getFullYear();
---

<footer>
  <p>&copy; {currentYear} {siteConfig.name}. Making dreams come true since 2002.</p>
  <p>
    <a href={`mailto:${siteConfig.social.email}`}>Email</a>
    <span aria-hidden="true">•</span>
    <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer me">LinkedIn</a>
    <span aria-hidden="true">•</span>
    <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer me">GitHub</a>
    <span aria-hidden="true">•</span>
    <a href={siteConfig.social.scholar} target="_blank" rel="noopener noreferrer">Google Scholar</a>
  </p>
</footer>

<style>
  footer {
    padding: 2rem 1rem;
    text-align: center;
    border-top: 1px solid var(--ctp-mocha-surface2);
    margin-top: 4rem;
  }

  footer p {
    margin: 0;
    font-size: 0.875rem;
    color: var(--ctp-mocha-subtext0);
  }

  footer a {
    color: var(--ctp-mocha-sapphire);
    text-decoration: none;
    transition: color 0.2s;
  }

  footer a:hover {
    color: var(--ctp-mocha-lavender);
  }
</style>
